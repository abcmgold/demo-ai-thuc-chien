# ============================================
# AI Thực Chiến - Ghi log AI (AI hook)
# ============================================
# Sao chép file này thành .env rồi điền token.
# TUYỆT ĐỐI không commit file .env (đã có trong .gitignore).

# Địa chỉ nhận log của Ban Tổ Chức (BTC). Không cần đổi.
AI_LOG_SERVER=https://live.thucchien.ai/api/ingest

# Token của ĐỘI bạn do BTC cấp (bắt đầu bằng "aitc_").
# Mỗi đội một token; đừng chia sẻ ra ngoài đội.
AI_LOG_API_KEY=

# (Tuỳ chọn) Thư mục chứa log cục bộ. Mặc định .ai-log
# AI_LOG_DIR=.ai-log

# Dak Lak backend (configure the organizer AI endpoint; server-side only)
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_REPAIR_ATTEMPTS=2
AI_TEMPERATURE=0.2
DEFAULT_TRANSPORT_MODE=self-arranged
DEFAULT_LODGING_LEVEL=standard
DEFAULT_PACE=balanced
BUDGET_SCOPE=total in-destination spending for the whole party

# Optional save flow; leave empty to disable saving
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=saved_itineraries
